    <!-- WhatsApp's hidden folders -->
    <string name="wa_offer_title">Clean WhatsApp’s hidden folders</string>
    <string name="wa_offer_body">WhatsApp keeps its own copy of every photo and video you send, plus stickers and media from chats you keep out of your gallery. Galleries can’t see these folders, so they quietly fill up. Share WhatsApp’s Media folder and DustIt will look inside.</string>
    <string name="wa_offer_allow">Allow access</string>
    <string name="wa_section_title">WhatsApp’s hidden folders</string>
    <string name="wa_section_subtitle">Files your gallery can’t see. Deleting one also removes it from the chat on this phone.</string>
    <string name="wa_section_looking">Looking in WhatsApp’s folders…</string>
    <string name="wa_section_empty">Nothing to clean up in WhatsApp’s hidden folders.</string>
    <string name="wa_wrong_folder_title">That’s not WhatsApp’s Media folder</string>
    <string name="wa_wrong_folder_body">DustIt needs the folder the picker opens on: Android › media › com.whatsapp › WhatsApp › Media. Open it and tap “Use this folder”.</string>
    <string name="wa_try_again">Try again</string>
