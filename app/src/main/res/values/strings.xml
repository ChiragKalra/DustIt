<resources>
    <string name="app_name">DustIt</string>

    <!-- Permission -->
    <string name="permission_title">Let’s clear the clutter</string>
    <string name="permission_body">DustIt looks through the photos and videos on this phone for chat screenshots, forwards, memes, duplicates and blurry shots you probably don’t need. It all runs on your device, and nothing ever leaves it.</string>
    <string name="permission_grant">Allow photo access</string>
    <string name="permission_denied">Photo access is turned off. Turn it on in Settings so DustIt can find clutter.</string>
    <string name="permission_open_settings">Open settings</string>
    <string name="permission_limited_title">Allow access to all photos</string>
    <string name="permission_limited_body">DustIt only works with access to all your photos, and it currently has just some. In Settings, tap Permissions, then Photos and videos, and choose “Always allow all”.</string>
    <string name="limited_access_title">DustIt needs all your photos</string>
    <string name="limited_access_body">You gave DustIt access to only some photos. It can’t find clutter that way, so it won’t work until you allow all of them.\n\nIn Settings, tap Permissions, then Photos and videos, and choose “Always allow all”.</string>
    <string name="limited_access_not_now">Not now</string>
    <string name="cancel">Cancel</string>

